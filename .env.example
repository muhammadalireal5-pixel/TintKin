# TintKin environment variables. Copy to .env.local and fill in. Never commit .env.local.

# Database (required)
MONGODB_URI=

# Auth.js session secret (required). Generate: openssl rand -base64 32
AUTH_SECRET=

# Public app URL, used for password-reset links (required in production; defaults to localhost in dev)
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (optional — button only shows if both are set). Redirect URI: <url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudinary — selfie/photo storage (required). https://console.cloudinary.com/settings/api-keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouCam AI Skin Analysis API (required — core scan/simulation feature)
YOUCAM_API_KEY=

# Qwen (DashScope) AI advice generation (required)
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_NAME=deepseek-v4-pro-0813

# Resend — transactional email (required). https://resend.com/api-keys
RESEND_API_KEY=

# Admin console (required for /admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Polar.sh billing (required to sell subscriptions). https://polar.sh/dashboard
# Org access token, scopes: checkouts:write, webhooks, products:write, orders:read, refunds:write
# (checkout, webhook verification, admin shop manager, and admin refunds)
POLAR_ACCESS_TOKEN=
# Webhook signing secret Polar generates for the endpoint (for /api/webhooks/billing)
POLAR_WEBHOOK_SECRET=
# Product ids from the Polar dashboard, one per paid tier
POLAR_PRODUCT_ID_STANDARD=
POLAR_PRODUCT_ID_PREMIUM=
# "production" once live; anything else (or unset) uses Polar's sandbox
POLAR_ENVIRONMENT=sandbox
# Credit-shop packs and custom-amount pricing are NOT env vars — they're
# managed live from /admin/shop, which creates/updates their Polar products
# via POLAR_ACCESS_TOKEN.

# Demo-only: lets users self-switch tiers from the UI, bypassing Polar checkout. Leave false/unset in production.
ENABLE_DEMO_TIER_SWITCHING=false

# Sentry error monitoring (optional — only auto-enables in production if DSNs are set)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Used at build time by @sentry/nextjs to upload source maps; only needed for production builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
