# ============================================================================
# TintKin — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ============================================================================

# ---- Database (REQUIRED) ---------------------------------------------------
# MongoDB Atlas (or any Mongo) connection string. Used by app/lib/mongoose.js.
# If unset, connectDb() falls back to "" and mongoose.connect will throw.
MONGODB_URI=

# ---- Auth.js / NextAuth (REQUIRED) -----------------------------------------
# Secret used to sign/encrypt session JWTs (auth.js) AND reused as the HMAC
# secret for the password-reset JWT flow (app/reset-password/**). Generate
# with: openssl rand -base64 32
# Password reset throws if this is unset (there is no hardcoded fallback).
AUTH_SECRET=
# Legacy alias some NextAuth v4 docs reference — auth.js falls back to this if
# AUTH_SECRET is unset. Only set if you're not setting AUTH_SECRET.
# NEXTAUTH_SECRET=

# Base URL of the deployed app. Used to build the password-reset link sent by
# email (app/lib/auth-actions.js). Defaults to http://localhost:3000 if unset.
NEXTAUTH_URL=http://localhost:3000
# AUTH_URL=   # alternate var name, checked as a fallback to NEXTAUTH_URL

# Google OAuth (OPTIONAL — Google sign-in button only appears if both are set)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Cloudinary (REQUIRED — selfie/photo storage) --------------------------
# Dashboard: https://console.cloudinary.com/settings/api-keys
# Public cloud name — exposed to the browser (next-cloudinary widget removed;
# still used directly for building image URLs client + server side).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# All uploads are server-signed with the API secret (no upload preset is used).
# New uploads are stored under the public_id prefix "users/<userId>/", and the
# server only accepts client-supplied image URLs from this cloud under the
# caller's own prefix. If an unsigned preset (e.g. the default "ml_default")
# still exists in Settings > Upload, consider deleting it: anyone who knows the
# public cloud name can upload to an unsigned preset.

# ---- YouCam AI Skin Analysis API (REQUIRED — core scan/simulation feature) -
# From the YouCam API Skin AI & Apparel VTO hackathon credentials.
YOUCAM_API_KEY=

# ---- AI advice generation (REQUIRED — Qwen via OpenAI-compatible endpoint) -
# Alibaba DashScope Qwen key. QWEN_API_KEY takes priority; OPENAI_API_KEY is
# used as a fallback key (NOT a switch to real OpenAI — base URL below still
# points at DashScope's OpenAI-compatible endpoint unless overridden).
QWEN_API_KEY=
# OPENAI_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_NAME=deepseek-v4-pro-0813

# ---- Resend (REQUIRED — transactional email: admin OTP + password reset) --
# https://resend.com/api-keys — sender domain "resend.dev" is used for
# testing and may need to be a verified domain for production sends.
RESEND_API_KEY=

# ---- Admin console (REQUIRED for /admin) -----------------------------------
# Only this exact email can request/verify an admin OTP login.
ADMIN_EMAIL=
# HMAC secret for signing the admin session cookie. Generate with:
# openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---- Billing webhook (REQUIRED if wiring up Polar/Stripe/LemonSqueezy/etc.)-
# Shared secret the webhook caller must send in the `x-webhook-secret` header
# (or `Authorization: Bearer <secret>`) to POST /api/webhooks/billing.
PAYMENT_WEBHOOK_SECRET=

# ---- Feature flags (OPTIONAL) ----------------------------------------------
# "true" allows users to self-switch tiers from the UI for demo purposes.
# Leave unset/false in production — real tier changes should go through the
# billing webhook above.
ENABLE_DEMO_TIER_SWITCHING=false

# ---- Sentry error monitoring (OPTIONAL) ------------------------------------
# Leave unset for local dev — Sentry only auto-enables in production unless
# NEXT_PUBLIC_SENTRY_DSN/SENTRY_DSN is explicitly set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Org/project slugs + auth token are used at BUILD time by @sentry/nextjs to
# upload source maps (next.config.mjs). Only needed for production builds;
# SENTRY_AUTH_TOKEN is read automatically by the Sentry build plugin even
# though it's not referenced directly in this repo's source.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
